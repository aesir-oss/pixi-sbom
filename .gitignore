# Generated by Cargo
# will have compiled files and executables; the workspace has one target/ at the root,
# and debug is anchored so a crate's src/debug/ module is never ignored
/debug/
target/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/
# pixi environments
# Pixi
.pixi/*
!.pixi/config.toml

# Documents a run from the repository root writes beside a lockfile by default
/sbom*.json

# MkDocs build output
site/

# Local Claude overrides — never commit
CLAUDE.local.md

# Triage reports — never commit
triage-*.md

# `pixi run perf` measurement dumps. Machine-specific timings and RSS figures, of no use to
# anyone else; head.json was committed by accident once already (#222).
/head.json
/base.json

# Python bytecode from the MkDocs hook
__pycache__/

# Generated beside the papers; the Markdown and the PDF are the committed pair
crates/pixi-sbom/docs/papers/*.html

# Worktrees Claude Code creates for background agents; each is its own checkout, never content of this one
.claude/worktrees/

# Environment files: never commit
.env
.env.*

# Python tooling used for the maturin builds and the docs
.venv/
.pytest_cache/

# The unpacked container images under examples/ (#31) hold a venv on purpose: it is what the example shows.
!examples/projects/container/*/*/app/.venv/
site-preview/
